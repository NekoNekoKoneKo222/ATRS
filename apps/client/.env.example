# Firebase Spark (無料) — docs/firebase-setup.md を参照
# Firebase Webアプリの「設定」から取得できる公開用Web設定値
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# 旧Supabase (移行期間中のフォールバック／WORKSHOP専用)
# Firebase設定が無い場合、既存のSupabaseアカウントとクラウドセーブを利用
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
